    {
      "parameters": {
        "jsCode": "return $input.all().map(item => ({\n  json: {\n    analysis: item.json.choices[0].message.content\n  }\n}));"
      },
      "id": "bf354890-b20d-4ff9-8063-df38b70bcac6",
      "name": "Extract Analysis",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const FALLBACK = {\n  problem: \"\",\n  pain_point: \"\",\n  product_area: \"Other\",\n  shopping_goal: \"\",\n  barrier_to_new_category: \"\",\n  user_persona: \"\",\n  emotion: \"\",\n  frequency: \"Occasional\",\n  priority: \"Low\",\n  recommended_action: \"\"\n};\n\nconst clean = (obj) => ({\n  problem: obj.problem ?? \"\",\n  pain_point: obj.pain_point ?? \"\",\n  product_area: obj.product_area ?? \"Other\",\n  shopping_goal: obj.shopping_goal ?? \"\",\n  barrier_to_new_category: obj.barrier_to_new_category ?? \"\",\n  user_persona: obj.user_persona ?? \"\",\n  emotion: obj.emotion ?? \"\",\n  frequency: obj.frequency ?? \"Occasional\",\n  priority: obj.priority ?? \"Low\",\n  recommended_action: obj.recommended_action ?? \"\"\n});\n\n// Source reviews for the current batch (to attach review_id + review text)\nconst sourceItems = $(\"Loop Over Items\").all();\nconst batchOffset = $runIndex * (sourceItems.length || 0);\n\nconst out = [];\n\nfor (const item of $input.all()) {\n  let raw = item.json.analysis ?? \"\";\n\n  // Remove ```json or ``` wrappers if present\n  raw = String(raw).trim()\n    .replace(/^```(?:json)?\\s*/i, \"\")\n    .replace(/\\s*```$/i, \"\")\n    .trim();\n\n  let analyses;\n  try {\n    const parsed = JSON.parse(raw);\n    analyses = (Array.isArray(parsed) ? parsed : [parsed]).map(o => clean(o || {}));\n  } catch (e) {\n    // One fallback per source review in the batch\n    analyses = sourceItems.map(() => ({ ...FALLBACK }));\n  }\n\n  for (let i = 0; i < analyses.length; i++) {\n    const src = sourceItems[i] ? sourceItems[i].json : {};\n    out.push({\n      json: {\n        review_id: batchOffset + i + 1,\n        review: src.text ?? \"\",\n        ...analyses[i]\n      }\n    });\n  }\n}\n\nreturn out;"
      },
