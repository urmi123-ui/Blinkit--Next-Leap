    {
      "parameters": {
        "jsCode": "const cleaned = [];\n\nfor (const item of $input.all()) {\n\n  let text = item.json.text || \"\";\n\n  // Remove HTML tags\n  text = text.replace(/<[^>]*>/g, \"\");\n\n  // Remove emojis\n  text = text.replace(/[\\u{1F300}-\\u{1FAFF}\\u{2600}-\\u{27BF}]/gu, \"\");\n\n  // Remove extra spaces\n  text = text.replace(/\\s+/g, \" \").trim();\n\n  cleaned.push({\n    json: {\n      ...item.json,\n      text: text\n    }\n  });\n\n}\n\nreturn cleaned;"
      },
      "id": "691e726d-1d67-44e7-bc97-caad7c149b26",
      "name": "Code in JavaScript",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -448,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "const reviews = items.map((item, index) => `Review ${index + 1}:\\n${item.json.text}`);\nconst prompt = reviews.join(\"\\n\\n\");\nconst instructions = `\n\nFor each review, return ONLY a valid JSON array.\n\nEach object MUST follow this schema:\n\n[\n  {\n    \"problem\":\"\",\n    \"pain_point\":\"\",\n    \"product_area\":\"\",\n    \"shopping_goal\":\"\",\n    \"barrier_to_new_category\":\"\",\n    \"user_persona\":\"\",\n    \"emotion\":\"\",\n    \"frequency\":\"Recurring/Occasional\",\n    \"priority\":\"\",\n    \"recommended_action\":\"\"\n  }\n]\n\nDefinitions:\n\n- problem: What is the user's main issue?\n- pain_point: Why is it frustrating?\n- product_area: Delivery, Search, Pricing, Catalog, Recommendation, App Experience, Payments, Support, Other\n- shopping_goal: What was the user trying to accomplish?\n- barrier_to_new_category: What prevents the user from trying new categories?\n- user_persona: Busy Professional, Student, Parent, Health-conscious, Budget Shopper, Pet Owner, etc.\n- emotion: Happy, Frustrated, Confused, Excited, Disappointed, Neutral\n- frequency: Recurring or Occasional\n- priority: High, Medium, Low\n- recommended_action: Product improvement recommendation\n\nReturn ONLY valid JSON.\n`;\nreturn [{\n  json: {\n    body: {\n      model: \"llama-3.3-70b-versatile\",\n      messages: [\n        { role: \"system\", content: \"You are a Senior Product Manager. Analyze customer reviews and return ONLY valid JSON.\" },\n        { role: \"user\", content: prompt + instructions }\n      ],\n      temperature: 0.2\n    }\n  }\n}];"
      },
      "id": "b33967b5-3e5f-455f-a0c3-bece97763e31",
      "name": "Code in JavaScript2",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ]
    },
